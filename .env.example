# Relational Database Connection URL (Supports SQLite, PostgreSQL, MySQL)
DATABASE_URL="sqlite:///./taskflow.db"

# CORS Allowed Origins
CORS_ORIGINS=["*"]

# User Authentication & JWT Settings
ALLOW_REGISTRATION=true
JWT_SECRET_KEY="some-secure-random-secret-key-taskflow"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Docker & Container Network Settings
HOST_IP="0.0.0.0"
HOST_PORT="5279"
